root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Third-party generated Anime4K shaders — do not reformat or normalise
[app/src/main/assets/anime4k/generated/**]
insert_final_newline = false
trim_trailing_whitespace = false

[*.png]
insert_final_newline = false
